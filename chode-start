#!/usr/bin/env bash
# chode-start — launch CHODE from this checkout (macOS/Linux). Plays ~/.chode/splash.mp4 first if you have one.
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$(command -v python3 || command -v python)"
if [ -z "$PY" ]; then
  echo "CHODE needs Python 3.9+. Get it at https://www.python.org/downloads/ (or: brew install python3 / sudo apt install python3)"
  exit 1
fi
exec "$PY" "$DIR/chode-launcher.py" "$@"
